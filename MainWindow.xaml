<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="STORM_STICKERS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:STORM_STICKERS"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    Title="STORM STICKERS"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="STORM STICKERS">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Taskbar System Tray Icon -->
        <tb:TaskbarIcon
            x:Name="MyTrayIcon"
            IconSource="ms-appx:///Assets/AppIcon.ico"
            ToolTipText="STORM STICKERS">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Открыть" Click="TrayOpen_Click" />
                    <MenuFlyoutItem Text="Выйти" Click="TrayExit_Click" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
